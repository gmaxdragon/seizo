# Preserve exact application and manifest hashes across operating systems.
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.patch text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gz binary
*.xz binary
*.png binary
*.jpg binary
*.npz binary
